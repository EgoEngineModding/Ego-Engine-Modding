<Application x:Class="EgoJpkArchiver.App" 
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
             xmlns:frontend="clr-namespace:EgoEngineLibrary.Frontend;assembly=EgoEngineLibrary.Frontend.Avalonia"
             RequestedThemeVariant="Default">
    <Application.DataTemplates>
        <frontend:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact" />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://EgoEngineLibrary.Frontend.Avalonia/EgoTheme.axaml" />
    </Application.Styles>
</Application>
